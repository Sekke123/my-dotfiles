{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/fastfetch/2b.txt",
        "color": {
            "1": "white"
        }
    },
"display": {

"separator": " ",

"color": {

"keys": "white",

"title": "white"

}

},

"modules": [

{ "type": "custom", "key": "╭───────────────────────────────────────────────╮" },

{ "type": "os", "key": "│ OS ", "format": "{pretty-name>34}        │" },

//{ "type": "command", "key": "│ Host ", "text": "cat /sys/class/dmi/id/product_name 2>/dev/null || uname -n", "format": "{>34} │" },

{ "type": "kernel", "key": "│ Kernel ", "format": "{2>34}    │" },

{ "type": "command", "key": "│ Uptime ", "text": "uptime -p | sed -E 's/up //; s/ days?/d/g; s/ hours?/h/g; s/ minutes?/m/g'", "format": "{>34}    │" },

{ "type": "command", "key": "│ Packages ", "text": "echo \"$(pacman -Q | wc -l) (pacman)\"", "format": "{>34}  │" },

{ "type": "command", "key": "│ Shell ", "text": "echo \"zsh $(zsh -c 'echo $ZSH_VERSION' | cut -d. -f1-3)\"", "format": "{>33}      │" },

{ "type": "command", "key": "│ WM ", "text": "echo \"Hyprland $(pacman -Q hyprland | cut -d' ' -f2 | cut -d'-' -f1) (Wayland)\"", "format": "{>34}        │" },

{ "type": "wmtheme", "key": "│ WM Theme ", "format": "{1>34}  │" },

{ "type": "theme", "key": "│ Theme ", "format": "{1>34}     │" },

{ "type": "font", "key": "│ Font ", "format": "{1>34}      │" },

{ "type": "cursor", "key": "│ Cursor ", "format": "{1>34}    │" },

{ "type": "command", "key": "│ Terminal ", "text": "kitty --version | awk '{print $1 \" \" $2}'", "format": "{>34} │" },

{ "type": "terminalfont", "key": "│ Term Font ", "format": "{1>34} │" },

//{ "type": "custom", "key": "│                                               │" },

{ "type": "custom", "key": "├───────────────────────────────────────────────┤" },

{ "type": "board", "key": "│ Board ", "format": "{1>34}     │" },

{ "type": "cpu", "key": "│ CPU ", "format": "{1>34}       │" },

{ "type": "gpu", "key": "│ GPU ", "hideType": "integrated", "format": "{2>34} │" },

{ "type": "command", "key": "│ Memory ", "text": "free -m | awk 'NR==2{printf \"%.2f / %.2f GiB\",$3/1024,$2/1024}'", "format": "{>34}    │" },

{ "type": "command", "key": "│ Disk ", "text": "df -h --output=size,used,fstype / | awk 'NR==2 {gsub(/G/,\"\",$1); gsub(/G/,\"\",$2); print $2 \" / \" $1 \" GiB - \" $3}'", "format": "{>34}      │" },

{ "type": "custom", "key": "│                                               │" },

//{ "type": "custom", "key": "├───────────────────────────────────────────────┤" },

//{ "type": "media", "key": "│ Media ", "format": "{1>34} │" },

{ "type": "command", "key": "│ Date/Time ", "text": "date +'%Y-%m-%d %H:%M:%S'", "format": "{>34} │" },

{ "type": "command", "key": "│ Weather ", "text": "curl -s 'wttr.in/?format=%t+-+%C'", "format": "{>35}   │" },

{ "type": "command", "key": "│ Media ", "text": "playerctl metadata --format '{{ title }}' 2>/dev/null | tr -cd '\\000-\\177' | cut -c 1-33", "format": "{>34} │" },

{ "type": "custom", "key": "│                                               │" },

//{ "type": "custom", "key": "├───────────────────────────────────────────────┤" },

{ "type": "custom", "key": "│ Delete System32 trust                         │" },

{ "type": "custom", "key": "╰───────────────────────────────────────────────╯" }

]

}
